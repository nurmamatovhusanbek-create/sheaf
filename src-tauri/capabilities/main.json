{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The one window: DOC-IPC commands and event listening, nothing else (SEC-IPC).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-snapshot",
    "allow-pages",
    "allow-apply",
    "allow-undo",
    "allow-render",
    "allow-open-files",
    "allow-unlock-pw",
    "allow-ocr-run",
    "allow-ocr-result",
    "allow-search",
    "allow-tool-run",
    "allow-export",
    "allow-job-cancel",
    "allow-jobs",
    "allow-reveal",
    "allow-settings",
    "allow-set-settings",
    "allow-choose-output-dir",
    "allow-clear-output-dir",
    "allow-pick-image",
    "allow-scan-devices",
    "allow-scan-start",
    "allow-scan-cancel",
    "allow-presets",
    "allow-preset-save",
    "allow-preset-delete",
    "allow-preset-run"
  ]
}
